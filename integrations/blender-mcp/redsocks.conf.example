// Managed by cloudflare-proxy.sh; independent of /etc/redsocks.conf.
base {
    log_debug = off;
    log_info = on;
    log = "stderr";
    daemon = off;
    redirector = iptables;
}
redsocks {
    local_ip = 127.0.0.1;
    local_port = 12347;
    ip = 127.0.0.1;
    port = 10808;
    type = http-connect;
}
